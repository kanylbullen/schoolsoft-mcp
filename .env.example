# SchoolSoft credentials for the MCP server.
# Copy to .env and fill in your real values. NEVER commit .env.

# The school slug as it appears in the SchoolSoft URL.
# Example: if you log in at https://sms.schoolsoft.se/yourschool/jsp/Login.jsp
# then SCHOOLSOFT_SCHOOL=yourschool
SCHOOLSOFT_SCHOOL=yourschool

SCHOOLSOFT_USERNAME=your-username
SCHOOLSOFT_PASSWORD=your-password

# User type: 1=student, 2=parent (default), 3=staff
SCHOOLSOFT_USERTYPE=2

# Optional: override base URL (for testing)
# SCHOOLSOFT_BASE_URL=https://sms.schoolsoft.se
